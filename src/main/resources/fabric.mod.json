{
	"schemaVersion": 1,
	"id": "xporbtrails",
	"version": "${version}",
	"name": "XP Orb Trails",
	"description": "Adds smooth, colorful, highly customizable trails and pickup flashes to experience orbs—without shaders.",
	"authors": [
		"GoldenEgg"
	],
	"license": "MIT",
	"icon": "assets/xporbtrails/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.goldenegg.xporbtrails.XpOrbTrailsClient"
		],
		"modmenu": [
			"dev.goldenegg.xporbtrails.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "xporbtrails.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.5",
		"minecraft": "${minecraft_dependency}",
		"java": ">=25",
		"fabric-api": "${fabric_api_dependency}"
	},
	"suggests": {
		"modmenu": "*"
	}
}
